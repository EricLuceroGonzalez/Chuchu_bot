# Redes activas, separadas por comas: bluesky, mastodon, x
ENABLED_PLATFORMS=bluesky,mastodon

# 1 = no publica ni toca MongoDB, solo muestra lo que haría
DRY_RUN=0
# Probabilidad de adjuntar la portada (0.0 – 1.0)
PROB_IMAGEN=0.1

# --- Bluesky: Ajustes → Privacidad y seguridad → Contraseñas de aplicación
BSKY_HANDLE=chuchubot.bsky.social
BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# BSKY_SERVICE=https://bsky.social

# --- Mastodon: Preferencias → Desarrollo → Nueva aplicación
# Permisos: write:statuses, write:media
MASTODON_BASE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=
# MASTODON_MAX_CHARS=500

# --- X (desactivado; requiere créditos de pago)
# X_API_KEY=
# X_API_KEY_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=

# --- MongoDB (mantén las variables que ya usa connect_DB.py)
